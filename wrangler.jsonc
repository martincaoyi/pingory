{
  // Cloudflare Worker 配置 —— Pingory 迁移（Fly → Workers，方案见 方案资料/uptime-monitor/迁移-Fly到永久免费主机-方案.md）
  "name": "pingory",
  "main": "src/cf-worker/index.js",
  "compatibility_date": "2026-10-01",
  // pg 驱动（node-postgres）必需
  "compatibility_flags": ["nodejs_compat"],
  // 静态资源：public/ 全量（含 8 语 i18n、privacy、状态页静态部分）
  // run_worker_first：这些动态路径必须先进 Worker——"/" 和 compare-*.html 在 public/ 有同名静态文件，
  // 不加的话静态层会抢先（根路径自定义域名状态页、compare 301 别名会被截走）。
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // none：与 Fly 行为一致——/privacy.html 直出 200（默认 auto-trailing-slash 会把 .html 307 到干净 URL，
    // 且该重定向发生在边缘静态层、先于 run_worker_first，导致隐私页多一跳 307）。
    // 已实证：ASSETS 绑定 fetch 不吃此重定向（/status.html 经绑定 200 直出），Worker 路径行为不变。
    "html_handling": "none",
    "run_worker_first": ["/", "/index.html", "/privacy.html", "/api/*", "/status/*", "/compare/*", "/vs/*", "/health", "/compare-uptimerobot.html", "/compare-betterstack.html", "/compare-pingdom.html", "/llms-txt-checker", "/llms-txt-checker.html", "/blog", "/blog.html", "/blog/*", "/ai-readability", "/ai-readability.html"]
  },
  // Hyperdrive：id 已回填（pingory-db，创建于 Cloudflare 预览部署阶段）
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "745e30181c6949b88d0d7fbac443f8d5" }
  ],
  // 每分钟主检查循环；月报在 scheduled 内按日期判断（对应 server.js 两个 setInterval）
  "triggers": {
    "crons": ["* * * * *"]
  },
  // Worker 专属 vars：放宽 DB 超时以容忍 Hyperdrive 免费档冷启动（闲置后首查询可能 >15s）。
  // Fly 路径的 .env 不含这些键，行为零变化。
  "vars": {
    "PG_CONN_TIMEOUT_MS": "20000",
    "PG_QUERY_TIMEOUT_MS": "30000",
    "PG_STATEMENT_TIMEOUT_MS": "30000",
    // 托管侧最低检查间隔覆盖（JSON 字符串）：Worker Cron 是 "* * * * *"，1 分钟粒度，
    // 托管环境最快只能 60 秒 ⇒ 把 Pro 的 30 秒钳到 60，绝不向用户假装 30 秒可用。
    // 自托管（server.js / .env）不设此变量 ⇒ 30 秒真实保留；/api/plan-features 靠
    // intervalClamped=true 让前端明确告知用户"托管最快 60 秒"，不是静默钳制。
    // 旧客户端仍提交 30 时，服务端按生效下限返回 plan_min_interval_hosted（托管专用码：
    // 通用码的文案会劝顶档用户"升级更快"，那是空头支票）。
    // ⚠️ 改这个数字必须同步 8 语 form.intervalHostedNote 里的 "60"（文案写死了秒数），
    //    否则提示与实际下限不一致。tools/test-interval-clamp.mjs 会盯住这个值。
    "PLAN_MIN_INTERVAL_OVERRIDE": "{\"pro\":60}"
  },
  "observability": {
    "enabled": true
  }
}
