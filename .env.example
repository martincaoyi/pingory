# ===== Pingory 环境变量模板 =====
# 复制本文件为 .env 后填入真实值。⚠️ .env 绝对不要提交 Git（已在 .gitignore）。
# 自部署最小可用配置：只需 SESSION_SECRET + STATUS_PAGE_SECRET（数据库用 docker compose 自带的即可）。
# 支付相关变量全部留空也能正常运行。

# ===== 服务器 =====
PORT=3000
SESSION_SECRET=change-me-to-random-64-chars    # 生产环境必须换随机字符串
STATUS_PAGE_SECRET=change-me-to-another-random-64-chars  # 私有状态页访问令牌密钥（G7，建议与 SESSION_SECRET 不同）

# ===== 支付开关 =====
# PAYMENT_PROVIDER 决定走哪条通道：creem（推荐/生产在用）或 paddle（备用通道）。
# ⚠️ 不设置时默认值是 paddle —— 若你用 Creem，必须显式写 creem，否则会走到 Paddle 分支。
# 完全不需要收款（纯自用/内网）时，本段及下面「Creem」「Paddle 备用通道」两段可整段留空或删除，
# 服务照常启动（/api/creem-config、/api/paddle-config 会返回 inactive，页面不显示结账入口）。
# PAYMENT_PROVIDER=creem

# ===== Creem（Merchant of Record，当前生产通道）=====
# 控制台：https://creem.io → Developers。创建 4 个产品（月付/年付 × Starter/Pro）后把 product id 填进来。
CREEM_ENVIRONMENT=test              # test（测试）或 live（正式）
CREEM_API_KEY=creem_test_xxx        # Creem → Developers → API Keys（服务端）
CREEM_WEBHOOK_SECRET=whsec_xxx      # Creem → Developers → Webhooks 创建后生成（/api/creem/webhook 验签用）
CREEM_STARTER_PRODUCT=prod_xxx      # Starter 月付产品 id（$4/月）
CREEM_STARTER_ANNUAL_PRODUCT=prod_xxx  # Starter 年付产品 id（$40/年）
CREEM_PRO_PRODUCT=prod_xxx          # Pro 月付产品 id（$6/月）
CREEM_PRO_ANNUAL_PRODUCT=prod_xxx   # Pro 年付产品 id（$60/年）

# ===== Paddle（备用通道，仅当 PAYMENT_PROVIDER=paddle 时启用）=====
# 生产已降为 dormant 备用。若不用 Paddle，本段可整段留空/删除。
PADDLE_ENVIRONMENT=sandbox          # sandbox（测试）或 live（正式）
PADDLE_API_KEY=pdl_sdbx_apikey_xxx  # Paddle Dashboard → Developer Tools → API Keys（服务端）
PADDLE_CLIENT_TOKEN=test_xxx        # Paddle Dashboard → Developer Tools → Client Token（前端）
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxx  # ⚠️ 完整复制含 pdl_ 前缀；Dashboard → Notifications → 创建 destination 时生成
STARTER_PRICE_ID=pri_xxx            # Starter 档 ($4/月)
PRO_PRICE_ID=pri_xxx                # Pro 档 ($6/月)
STARTER_ANNUAL_PRICE_ID=pri_xxx     # Starter 档 ($40/年, billing=annually)
PRO_ANNUAL_PRICE_ID=pri_xxx         # Pro 档 ($60/年, billing=annually)

# ===== 数据库（PostgreSQL）=====
# 用 docker compose 自带的 Postgres（推荐新手）：本行可整行注释掉或删除，
#   compose 会自动注入 DATABASE_URL=postgresql://pingory:pingory@db:5432/pingory。
# 用外部库（Neon / Supabase / RDS / 自建）：取消注释并填连接串。
# DATABASE_URL=postgresql://neondb_owner:密码@ep-xxx.neon.tech/neondb?sslmode=require
# 生产建议 sslmode=verify-full（强制验证证书）

# ===== 邮件（Resend SMTP relay，2026-09-05 起生产用 Resend）=====
# 生产用 Resend（海外送达最优、代码零改动走 SMTP relay）。注册 resend.com → 验证发件域名 → API Keys 建 Full access key。
SMTP_HOST=smtp.resend.com           # Resend SMTP relay
SMTP_PORT=465                       # 465（SSL）；Resend 亦支持 587/25/2465/2587
SMTP_SECURE=true                    # SMTP_PORT=465 时 true；587 时 false
SMTP_USER=resend                    # Resend 固定用户名 resend
SMTP_PASS=your_resend_api_key       # = Resend API Key（re_ 开头）
SMTP_FROM="Pingory Alerts <alerts@pingory.com>"  # 发件地址，必须是已验证域名下的邮箱
ALERT_TO_EMAIL=admin@yourdomain.com # 「客户反馈通知」收件人（管理员）。⚠️ 不用于监控告警——告警邮件固定发往「监控归属账号」的注册邮箱。

# ===== 超级管理员 + 应用地址 =====
# 启动时若设置且账号不存在，自动建立 role=admin 的超级账号（可用于测试全部功能 + 进 /admin 后台）
ADMIN_EMAIL=admin@pingory.com         # 超级管理员邮箱（留空则不自动建）
ADMIN_PASSWORD=change-me-admin-strong # 超级管理员密码（至少 8 位）
APP_URL=https://pingory.com           # 邮箱验证邮件里的链接前缀；不填默认 https://pingory.com

# ===== OAuth 社交登录（⑤⑥，2026-09-06）=====
# GitHub：https://github.com/settings/developers → OAuth Apps；回调填 <APP_URL>/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# Google：https://console.cloud.google.com → APIs & Services → Credentials → OAuth client ID（Web application）；
# ⚠️ 回调必须填在"已获授权的重定向 URI(Authorized redirect URIs)"，不是"已获授权的 JavaScript 来源(JS origins)"——
#    JS origins 只接受裸域名(无路径)，带路径必报"URI 包含路径或以 / 结尾"
# Authorized redirect URIs 填 <APP_URL>/api/auth/oauth/google/callback；测试用户需加自己的邮箱
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===== 多区域探针（G3，可选）=====
# 配置后，付费档(Starter/Pro)监控会从多个地理节点探测，"多数确认"降误报。
# 每个节点需是独立部署的 worker 进程，对外暴露 POST /probe 端点，
# 接收 body: { "monitor": {...}, "region": "节点名" }，
# 返回 JSON: { "status": "up"|"down", "error": "...", "responseTime": 123, "warn": null }。
# - baseUrl 为 null（或省略）→ 本机本地探测（默认）。
# - baseUrl 填真实 worker 地址 → 委托该节点探测。
# 不配置（留空/整行注释）则默认单点：仅 local 本机探测。
# ⚠️ 部署要点：每个 baseUrl 对应的 worker 节点需独立部署同一套代码并运行 `node src/worker.js`，
#    与主服务连同一 Neon 库；未配置 PROBE_REGIONS 则默认单点（仅 local 本机探测）。
#    可选共享密钥 PROBE_SECRET（两端都设才启用校验），防止探针端点被公开调用。
# 支持的 name 仅作展示标识，可自定义（如 us-east / eu-west / ap-sg）。
PROBE_REGIONS=[{"name":"local","baseUrl":null},{"name":"us-east","baseUrl":"https://probe-us.example.com"},{"name":"eu-west","baseUrl":"https://probe-eu.example.com"}]

# ===== 探针节点自身配置（G3，仅部署 worker 时用）=====
# 以下三项由 `node src/worker.js` 读取，主服务（server.js）不读；不部署 worker 则无需设置。
# PROBE_REGION_NAME=us-east    # 本节点区域名，需与上面 PROBE_REGIONS 里的 name 一致（默认取 hostname）
# PROBE_PORT=3100              # 探针服务监听端口（默认 3100）
# PROBE_SECRET=                 # 与主服务一致的共享密钥（两端都设才启用校验）

# ===== 可选 =====
# NODE_ENV=production          # 生产环境建议设置；不设置也能运行
